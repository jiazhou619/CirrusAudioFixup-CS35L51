@@ -135,6 +135,19 @@
 constexpr uint32_t kRegDsp1MpuYregAccess3 = 0x02BC305C;
 
 constexpr uint32_t kValDeviceId = 0x00035A40;
+// CS35L51/CS35L53 are Halo-family parts: same register map, same WMFW framing and
+// the same DSP boot sequence as the CS35L41, but a different DEVID (CS35L41 =
+// 0x35A40, CS35L51 = 0x35A51). Board discovery cannot read the part before
+// registering a driver, so selection uses the family identity below and the
+// first register read validates the real DEVID by family.
+constexpr uint32_t kHaloFamilySiliconId = 0x00035A00;
+constexpr uint32_t kHaloFamilyMask = 0xFFFFFF00;
+// CS35L56 reports a DEVID inside the same 0x35Axx block but has its own register
+// map and driver, so it must not be claimed by the Halo (CS35L41/CS35L51) path.
+constexpr uint32_t kValDeviceIdCs35l56 = 0x00035A56;
+constexpr bool isSupportedDeviceId(uint32_t id) {
+    return (id & kHaloFamilyMask) == kHaloFamilySiliconId && id != kValDeviceIdCs35l56;
+}
 constexpr uint32_t kValSoftwareReset = 0x5A000000;
 constexpr uint32_t kValHaloCoreEnable = 0x00000001;
 constexpr uint32_t kValHaloCoreReset = 0x00000200;
