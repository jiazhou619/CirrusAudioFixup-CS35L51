+// Halo-family parts (CS35L41/CS35L51) share one register map, WMFW framing and
+// DSP boot sequence, so the CS35L41 driver owns both.
+constexpr bool isHaloAmplifier(AmplifierModel model) {
+    return model == AmplifierModel::CS35L41 || model == AmplifierModel::CS35L51;
